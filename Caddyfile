# Railway serves the static export (out/) with Caddy. Railpack picks this file
# up in place of its default and fills in {{.DIST_DIR}}; everything else here is
# its default, with three changes:
#
#   1. Cache headers. The default sends none, so every returning visitor
#      re-asked for every script, font, image and video on each visit.
#   2. No single-page-app fallback. Railpack assumes one for Next.js and answers
#      every missing URL with the homepage and a 200 — including scripts that
#      no longer exist after a redeploy, which a phone still holding the old page
#      then tries to run. This site is one page; a missing file is a 404.
#   3. The export's own 404.html for those.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8 # trust railway's proxy
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	root * {{.DIST_DIR}}

	encode zstd gzip

	# Named after their contents: a changed file gets a new name, so a copy
	# can be kept for good.
	@hashed path /_next/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Keep their names when replaced. Fresh for a day, then served from cache
	# while a new copy is fetched behind it — a returning visitor never waits
	# on them, and a replaced file still shows up within a day.
	@assets path /media/* /images/* /Glitz/* /icon.png /apple-icon.png
	header @assets Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	# The page itself is always checked, so a deploy is live on the next visit.
	@pages path / /index.html *.txt
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	try_files {path} {path}.html {path}/index.html

	file_server {
		hide .git
		hide .env*
	}

	handle_errors {
		# Never let a miss be remembered: a file that is missing now may be
		# back after a rollback.
		header Cache-Control "no-store"
		rewrite * /{err.status_code}.html
		file_server
	}
}
